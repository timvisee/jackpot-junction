#!/usr/bin/env bash
# Runs a scene headless for a number of frames and fails on any script error in the output, and on
# anything left behind at exit.
# Usage: tools/smoke res://scenes/dev/playground.tscn [frames]
#
# It quits the way a player does, through Game.quit, rather than with the engine's --quit-after:
# quitting while a sound plays leaves the sound behind, which the engine reports as instances
# leaked and resources still in use, and Game.quit stops every sound and waits for the mixer to let
# go of them first.
set -uo pipefail
# On the settings and profiles every test and check shares, never the player's own, GAME.md 10.2.
export JJ_SETTINGS="${JJ_SETTINGS:-tests.cfg}"
scene="${1:?scene path required}"
frames="${2:-120}"
output=$(tools/godot --headless --path . "$scene" -- --run-frames="$frames" 2>&1)
status=$?
printf '%s\n' "$output"
errors=$(grep -E 'SCRIPT ERROR|USER ERROR|Parse Error|^ERROR:|leaked at exit' <<<"$output")
if [[ $status -ne 0 || -n $errors ]]; then
	echo "smoke run of $scene failed" >&2
	exit 1
fi
echo "smoke run of $scene ok ($frames frames)"
