#!/usr/bin/env bash
# Says whether an APK is signed with the release key, and by nothing else: its signer's certificate
# against the one in the keystore, by their SHA-256 digests. GAME.md 10.5. The key is read from
# ANDROID_KEYSTORE, ANDROID_KEYSTORE_ALIAS and ANDROID_KEYSTORE_PASSWORD; apksigner from the newest
# build tools under ANDROID_HOME that can read the APK here, or from the path. The newest build
# tools can want a newer Java than the one the APK was exported with, and then read nothing at
# all, which is also why Godot signs with an older one of them.
#
# Usage: tools/android-signed build/android/jackpot-junction.apk
set -euo pipefail
apk="${1:?APK path required}"
apksigners=()
if [[ -n ${ANDROID_HOME:-} && -d $ANDROID_HOME/build-tools ]]; then
	while read -r version; do
		apksigners+=("$ANDROID_HOME/build-tools/$version/apksigner")
	done < <(find "$ANDROID_HOME/build-tools" -mindepth 1 -maxdepth 1 -printf "%f\n" | sort -rV)
fi
apksigners+=(apksigner)
apksigner="no apksigner that could read it"
printed=""
for candidate in "${apksigners[@]}"; do
	if printed=$("$candidate" verify --print-certs "$apk" 2>/dev/null) &&
		grep -q '^Signer #1 certificate SHA-256 digest: ' <<<"$printed"; then
		apksigner=$candidate
		break
	fi
	printed=""
done
wanted=$(keytool -list -v -keystore "$ANDROID_KEYSTORE" -alias "$ANDROID_KEYSTORE_ALIAS" \
	-storepass:env ANDROID_KEYSTORE_PASSWORD | sed -n 's/^[[:space:]]*SHA256: //p' |
	tr -d ':' | tr 'A-F' 'a-f')
signed=$(sed -n 's/^Signer #1 certificate SHA-256 digest: //p' <<<"$printed")
signers=$(grep -c '^Signer #[0-9]* certificate DN' <<<"$printed" || true)
if [[ -z $wanted || $wanted != "$signed" || $signers -ne 1 ]]; then
	# What was compared, which is no secret: a certificate's digest is on every copy of the APK.
	echo "$apk is not signed with the release key alone" >&2
	echo "  the key's certificate:  ${wanted:-none read from the keystore}" >&2
	echo "  the APK's first signer: ${signed:-none}, of $signers signer(s), by $apksigner" >&2
	exit 1
fi
echo "$apk is signed with the release key ($signed)"
