def render(scratch: pathlib.Path, shot: tuple, mode: dict) -> str | None:
    """Plays and records [shot] in a user directory of its own, so the player's settings and
    profiles are never touched: no music, which the trailer lays under itself, no control hints,
    and frames not held to a display. Returns why it failed, or None."""
    name, length, scene, args, _ = shot
    user = scratch / name / "godot/app_userdata/Jackpot Junction"
    user.mkdir(parents=True, exist_ok=True)
    wide, tall = mode["drawn"]
    (user / "settings.cfg").write_text(SETTINGS % (wide, tall))
    shots = OUT / mode["shots"]
    movie = shots / f"{name}.avi"
    movie.unlink(missing_ok=True)
    command = [
        str(ROOT / "tools/godot"), "--path", str(ROOT), "--resolution", f"{wide}x{tall}",
        "--fixed-fps", str(FPS), "--write-movie", str(movie), scene, "--",
        f"--trailer={name}", f"--length={length}", f"--tail={TAIL}",
    ] + args.split()  # fmt: skip
    env = dict(os.environ, XDG_DATA_HOME=str(scratch / name))
    log = shots / f"{name}.log"
    with open(log, "w") as written:
        # A session of its own, so a run past its time goes with everything it started: the hidden
        # display and the game under it, which otherwise hold on to a display backend each.
        run = subprocess.Popen(
            command, env=env, stdout=written, stderr=subprocess.STDOUT, start_new_session=True
        )
        try:
            # Bounded: a shot whose script fails to load, or that falls out of its match, never
            # quits.
            run.wait(timeout=mode["timeout"])
        except subprocess.TimeoutExpired:
            os.killpg(run.pid, signal.SIGKILL)
            run.wait()
            return "timed out"
    if "TRAILER_ACTION" not in log.read_text() or not movie.exists():
        return f"see {log}"
    return None


def frames_in(movie: pathlib.Path) -> int:
    # Counted by their packets, a frame each in the movie writer's recordings, as decoding them all
    # takes minutes at 8K.
    probe = subprocess.run(
        ["ffprobe", "-v", "error", "-count_packets", "-select_streams", "v",
         "-show_entries", "stream=nb_read_packets", "-of", "csv=p=0", str(movie)],
        capture_output=True, text=True, check=True,
    )  # fmt: skip
    return int(probe.stdout.strip())


def overlap(transition: tuple) -> float:
    """How much of a cut [transition] lays its two shots over each other: none for a cut or for
    going through black, which fades each on its own and holds black between them."""
    kind, seconds = transition[0], transition[1]
    return 0.0 if kind in ("cut", "black") else seconds


def zoomed(frames: int, kind: str, seconds: float, amount: float) -> str:
    """A shot's frames drawn closer over the [seconds] of a zoomed dissolve: the shot going out
    drawn in to [amount] more over its last, [kind] "out", the one coming in drawn from that close
    back to where it is over its first, "in"; or pushed in on over all of its frames, quick and
    then slow, to [amount] more by its end, "push"; as a filter after its frames are trimmed."""
    span = round(seconds * FPS)
    if kind == "out":
        grow = f"1+{amount}*clip((on-{frames - span})/{span},0,1)"
    elif kind == "push":
        grow = f"1+{amount}*(1-pow(1-clip(on/{frames},0,1),2))"
    else:
        grow = f"1+{amount}*clip(1-on/{span},0,1)"
    return (
        f",zoompan=z='{grow}':d=1:x='iw/2-(iw/zoom/2)':y='ih/2-(ih/zoom/2)':s={{size}}:fps={FPS}"
        ",settb=AVTB"
    )


# How each piece of the trailer is kept between the steps of its cut: losslessly, every frame whole,
# and all alike, as they are read one after another as if one.
