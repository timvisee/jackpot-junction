PIECE += ["-threads", "8"]
# What a piece's frames are, which it keeps no record of, told again as it is read back, so nothing
# takes them for any other colors and converts them.
READ_BACK = "setparams=range=tv:colorspace=bt709:color_primaries=bt709:color_trc=bt709"


def cut(mode: dict) -> None:
    """The trailer cut in steps, none holding more than a shot or two at once however large they
    were drawn, as ffmpeg keeps every input it is given open, decoding, to its end: each shot's
    picture made ready on its own and kept in pieces, the frames it shares with the shot either side
    apart from the rest; each transition laid across the two pieces it joins; the sound mixed apart;
    and the pieces read one after another, black held between them where the trailer goes through
    black and at its very end, and encoded with the sound once for each trailer."""
    shots = SHOTS_IN_ORDER
    held = sum(shot[4][2] for shot in shots if shot[4][0] == "black")
    total = sum(shot[1] for shot in shots) + held + END_BLACK
    spans = _spans(mode)
    # Beside the trailers rather than in a temporary folder, which may be kept in memory.
    with tempfile.TemporaryDirectory(dir=OUT, prefix="cut-") as scratch:
        pieces = pathlib.Path(scratch)
        order = _pictures(mode, spans, pieces)
        sound = pieces / "sound.wav"
        _sound(spans, total, sound)
        trailers = _encoded(mode, order, sound, total, pieces)
    for trailer in trailers:
        print(f"trailer: {trailer.relative_to(ROOT)} ({total:g} s)")


def _spans(mode: dict) -> list[tuple]:
    """Each shot's recording and its frames in the trailer, from its action, as long as it is, with
    half of each transition it shares on either side; how it comes in and goes out; and whether it
    is the last."""
    shots = SHOTS_IN_ORDER
    spans = []
    for k, (name, seconds, _, _, into) in enumerate(shots):
        after = shots[k + 1][4] if k + 1 < len(shots) else CUT
        movie = OUT / mode["shots"] / f"{name}.avi"
        # The run quits as many frames after the action as the shot and its tail are long.
        action = frames_in(movie) - round((seconds + TAIL) * FPS)
        start = action - round(overlap(into) / 2 * FPS)
        end = action + round((seconds + overlap(after) / 2) * FPS)
        spans.append((movie, start, end, into, after, k == len(shots) - 1))
    return spans


def _fades(span: tuple, size: str) -> tuple[str, str]:
    """A shot's picture's and sound's fades, as filters after its frames are trimmed: going through
    black, faded out at its end or in from it; drawn closer over a zoomed dissolve; and the last out
    to black over its end, before the black held after it."""
    _, start, end, into, after, last = span
    clip = (end - start) / FPS
    fades = ""
    sound_fades = ""
    if after[0] == "zoomfade":
        fades += zoomed(end - start, "out", after[1], after[2]).replace("{size}", size)
    if into[0] == "zoomfade":
        fades += zoomed(end - start, "in", into[1], into[2]).replace("{size}", size)
    if into[0] == "pushfade":
        fades += zoomed(end - start, "push", into[1], into[2]).replace("{size}", size)
    if after[0] == "black" and after[1] > 0.0:
        fades += f",fade=t=out:st={clip - after[1]:.4f}:d={after[1]}"
        sound_fades += f",afade=t=out:st={clip - after[1]:.4f}:d={after[1]}"
    if into[0] == "black" and into[3] > 0.0:
        fades += f",fade=t=in:st=0:d={into[3]}"
        sound_fades += f",afade=t=in:st=0:d={into[3]}"
    if last:
        fades += f",fade=t=out:st={clip - STING_OUT:.4f}:d={STING_OUT}"
        sound_fades += f",afade=t=out:st={clip - STING_OUT:.4f}:d={STING_OUT}"
    return fades, sound_fades


def _pictures(mode: dict, spans: list[tuple], pieces: pathlib.Path) -> list[pathlib.Path]:
    """Each shot's picture at the first trailer's size and in its colors, kept as its head, the
    frames it shares with the shot before, its body and its tail, those it shares with the one
    after; each transition laid across a tail and the head after it. Returns the pieces in the
    trailer's order, black held where it goes through black and at its very end."""
    wide, tall = mode["outs"][0][0]
    size = f"{wide}x{tall}"
    order = []
    for k, span in enumerate(spans):
        movie, start, end, into, after, _ = span
        frames = end - start
        coming = round(overlap(into) * FPS)
        going = round(overlap(after) * FPS)
        fades, _ = _fades(span, size)
        parts = {
            "head": (0, coming),
            "body": (coming, frames - going),
            "tail": (frames - going, frames),
        }
        kept = {part: (first, past) for part, (first, past) in parts.items() if past > first}
        graph = [
            f"[0:v]trim=start_frame={start}:end_frame={end},setpts=PTS-STARTPTS,fps={FPS},"
            f"scale={wide}:{tall}:flags=lanczos:{RANGE},format=yuv420p,settb=AVTB{fades},"
            f"split={len(kept)}" + "".join(f"[{part}]" for part in kept)
        ]
        written = []
        for part, (first, past) in kept.items():
            graph.append(
                f"[{part}]trim=start_frame={first}:end_frame={past},"
                f"setpts=PTS-STARTPTS[{part}_kept]"
            )
            written += ["-map", f"[{part}_kept]", *PIECE, str(pieces / f"{k}-{part}.nut")]
        _ffmpeg(["-i", str(movie), "-filter_complex", ";".join(graph), *written])
        if into[0] == "black" and into[2] > 0.0:
            order.append(_black(pieces / f"{k}-held.nut", into[2], size))
        if coming:
            kind = "fade" if into[0] in ("zoomfade", "pushfade") else into[0]
            joined = pieces / f"{k}-joined.nut"
            _ffmpeg([
                "-i", str(pieces / f"{k - 1}-tail.nut"), "-i", str(pieces / f"{k}-head.nut"),
                "-filter_complex",
                (
                    f"[0:v]{READ_BACK},settb=1/{FPS},setpts=N[going];"
                    f"[1:v]{READ_BACK},settb=1/{FPS},setpts=N[coming];"
                    f"[going][coming]xfade=transition={kind}:duration={into[1]}:offset=0,"
                    "format=yuv420p[joined]"
                ),
                "-map", "[joined]", *PIECE, str(joined),
            ])  # fmt: skip
            order.append(joined)
        if "body" in kept:
            order.append(pieces / f"{k}-body.nut")
    order.append(_black(pieces / "end.nut", END_BLACK, size))
    return order


def _black(piece: pathlib.Path, seconds: float, size: str) -> pathlib.Path:
    _ffmpeg([
        "-f", "lavfi", "-i", f"color=c=black:s={size}:r={FPS}:d={seconds}",
        "-vf", "format=yuv420p", *PIECE, str(piece),
    ])  # fmt: skip
    return piece


def _sound(spans: list[tuple], total: float, sound: pathlib.Path) -> None:
    """Each shot's own sound, joined as their pictures are, quieter under the music: the music's
    layers each looped, as the track is made to be, so it runs on under the license past its own
    end. Each shot's recording read for its sound alone, its frames passed over undecoded."""
    inputs: list[str] = []
    graph: list[str] = []
    for k, span in enumerate(spans):
        movie, start, end, into, _, _ = span
        _, sound_fades = _fades(span, "")
        inputs += ["-vn", "-i", str(movie)]
        graph.append(
            f"[{k}:a]atrim=start={start / FPS:.4f}:end={end / FPS:.4f},asetpts=PTS-STARTPTS,"
            f"aresample=48000{sound_fades}[a{k}]"
        )
        if k == 0:
            graph.append("[a0]anull[aj0]")
            continue
        joined = f"[aj{k - 1}]"
        if into[0] == "black" and into[2] > 0.0:
            graph.append(f"anullsrc=r=48000:cl=stereo,atrim=0:{into[2]}[gap{k}]")
            graph.append(f"{joined}[gap{k}]concat=n=2:v=0:a=1[held{k}]")
            joined = f"[held{k}]"
        if overlap(into) == 0.0:
            graph.append(f"{joined}[a{k}]concat=n=2:v=0:a=1[aj{k}]")
        else:
            graph.append(f"{joined}[a{k}]acrossfade=d={into[1]}[aj{k}]")
    last = len(spans) - 1
    graph.append(f"anullsrc=r=48000:cl=stereo,atrim=0:{END_BLACK}[enda]")
    graph.append(f"[aj{last}][enda]concat=n=2:v=0:a=1,volume={GAME_SOUND}[game]")
    music = len(spans)
    for layer in LAYERS:
        inputs += ["-stream_loop", "-1", "-ss", f"{MUSIC_FROM}", "-i", str(MUSIC / layer)]
    graph.append(f"[{music}:a]atrim=0:{total},asetpts=PTS-STARTPTS,asplit[through][calm]")
    graph.append(f"[{music + 1}:a]atrim=0:{total},asetpts=PTS-STARTPTS[tense]")
    graph.append(f"[{music + 2}:a]atrim=0:{total},asetpts=PTS-STARTPTS[peak]")
    # Each part's loudness over the trailer: the muffled one up slowly to the drop and gone at it,
    # then back, sliding in as the full one slides out over the end card's last bars, and on
    # unchanged under the license, out with its picture; the full one from the drop to there. The
    # layers are different recordings, which at half each add up quieter than either: each switch
    # between them shares out their power rather than their amplitude, so nothing dips.
    shots = SHOTS_IN_ORDER
    starts = _starts(shots)
    card = next(t for t, shot in zip(starts, shots) if shot[0] == "endcard")
    card_end = card + next(shot[1] for shot in shots if shot[0] == "endcard")
    muffle_from = card_end - MUFFLE_INTO
    sound_end = total - END_BLACK
    seam = 0.06
    muffled = (
        f"if(lt(t,{DROP + seam}),min(t/{FADE_IN},1)*{_even(f'({DROP + seam}-t)/{2 * seam}')},"
        f"{STING_MUSIC}*clip((t-{muffle_from})/{MUFFLE_INTO},0,1)"
        f"*clip(({sound_end + MUSIC_PAST}-t)/{MUSIC_OUT},0,1))"
    )
    full = f"{_even(f'(t-{DROP - seam})/{2 * seam}')}*clip(({card_end}-t)/{MUFFLE_INTO},0,1)"
    # How far the full music has settled from the tense layer into the calm one after the drop, and
    # gone up into each layer above the calm one by then.
    down = f"clip((t-{SETTLED - SETTLING:g})/{SETTLING:g},0,1)"
    before, after = LAYER_SWAP
    up = [f"clip((t-{at - before:g})/{before + after:g},0,1)" for at in LAYER_UP]
    shares = {
        "calm": _even(f"{down}-{up[0]}"),
        "tense": _even(f"1-{down}+{up[0]}-{up[1]}"),
        "peak": _even(up[1]),
    }
    graph.append(
        f"[through]lowpass=f={MUFFLED},lowpass=f={MUFFLED},volume={MUFFLED_GAIN},"
        f"volume='{muffled}':eval=frame[muffled]"
    )
    for layer, share in shares.items():
        graph.append(f"[{layer}]volume='{full}*{share}':eval=frame[{layer}_full]")
    graph.append(
        "[muffled][calm_full][tense_full][peak_full]amix=inputs=4:normalize=0[music]"
    )
    graph.append(f"[game][music]amix=inputs=2:normalize=0:duration=longest,atrim=0:{total}[sound]")
    _ffmpeg([
        *inputs, "-filter_complex", ";".join(graph), "-map", "[sound]", "-c:a", "pcm_f32le",
        str(sound),
    ])  # fmt: skip


def _even(share: str) -> str:
    """The loudness of a layer given [share] of the sound, 0 to 1, as an expression in ffmpeg's
    terms: two layers switched between, their shares adding up to one, keep its power the same all
    through the switch."""
    return f"sin(PI/2*clip({share},0,1))"


# How many threads each trailer's encoder works on: on all of them, one at 4K alone holds 5 GB.
ENCODER_THREADS = 8


def _encoded(
    mode: dict, order: list[pathlib.Path], sound: pathlib.Path, total: float, pieces: pathlib.Path
) -> list[pathlib.Path]:
    """The pieces read one after another, each frame timed by its place, faded up out of black, and
    encoded with the sound once for each trailer, scaled down to its size. Returns the trailers."""
    listing = pieces / "pieces.txt"
    listing.write_text("".join(f"file '{piece}'\n" for piece in order))
    outs = mode["outs"]
    pictures = "".join(f"[picture{i}]" for i in range(len(outs)))
    graph = [
        (
            f"[0:v]{READ_BACK},settb=1/{FPS},setpts=N,fade=t=in:st=0:d={PICTURE_IN},"
            "format=yuv420p,"
            f"split={len(outs)}{pictures}"
        )
    ]
    written: list[str] = []
    trailers = []
    for i, ((wide, tall), ending, crf) in enumerate(outs):
        if (wide, tall) == outs[0][0]:
            graph.append(f"[picture{i}]null[shown{i}]")
        else:
            graph.append(
                f"[picture{i}]scale={wide}:{tall}:flags=lanczos:in_range=tv:out_range=tv,"
                f"format=yuv420p[shown{i}]"
            )
        trailer = OUT / f"jackpot-junction-trailer{ending}.mp4"
        trailers.append(trailer)
        written += [
            "-map", f"[shown{i}]", "-map", "1:a",
            "-t", f"{total}", "-c:v", "libx264", "-preset", "slow", "-crf", str(crf),
            "-threads", str(ENCODER_THREADS),
            "-pix_fmt", "yuv420p", "-color_range", "tv", "-colorspace", "bt709",
            "-color_primaries", "bt709", "-color_trc", "bt709", "-r", str(FPS),
            "-c:a", "aac", "-b:a", "320k", "-ar", "48000", "-movflags", "+faststart", str(trailer),
        ]  # fmt: skip
    _ffmpeg([
        "-f", "concat", "-safe", "0", "-i", str(listing), "-i", str(sound),
        "-filter_complex", ";".join(graph), *written,
    ])  # fmt: skip
    return trailers


def _ffmpeg(args: list[str]) -> None:
    subprocess.run(["ffmpeg", "-hide_banner", "-v", "error", "-nostdin", "-y", *args], check=True)


def drawn_at(size: tuple[int, int], quality: float) -> pathlib.Path:
    """The size every run draws at, and how well its movie writer keeps each frame, written where
    Godot reads its project settings' overrides: its movie writer records at the project's window
    size whatever the command line asks, so the window is overridden for as long as the shots are
    recorded. Returns the file, to be removed."""
    override = ROOT / "override.cfg"
    override.write_text(
        "[display]\n\n"
        f"window/size/window_width_override={size[0]}\n"
        f"window/size/window_height_override={size[1]}\n\n"
        "[editor]\n\n"
        f"movie_writer/mjpeg_quality={quality}\n"
    )
    return override


def main() -> None:
    # Before a single shot is drawn: the music is licensed and lives in a private repository,
    # GAME.md 10.6, so a checkout may not have it.
    if not all((MUSIC / layer).is_file() for layer in LAYERS):
        missing = MUSIC.relative_to(ROOT)
        print(f"trailer: no music in {missing}, see make private-assets", file=sys.stderr)
        sys.exit(1)
    mode = DRAFT
    if "--final" in sys.argv[1:]:
        mode = FINAL
    elif "--8k" in sys.argv[1:]:
        mode = ULTRA
    (OUT / mode["shots"]).mkdir(parents=True, exist_ok=True)
    if "--cut" in sys.argv[1:]:
        cut(mode)
        return
    wanted = [arg for arg in sys.argv[1:] if not arg.startswith("--")]
    todo = [shot for shot in SHOTS_IN_ORDER if not wanted or shot[0] in wanted]
    jobs = int(os.environ.get("JOBS", mode["jobs"]))
    override = drawn_at(mode["drawn"], mode["mjpeg"])
    try:
        with tempfile.TemporaryDirectory() as scratch:
            for shot in todo:
                print(f"trailer: {shot[0]} ({shot[1]:g} s)", flush=True)
            with concurrent.futures.ThreadPoolExecutor(jobs) as pool:
                reasons = list(
                    pool.map(lambda shot: render(pathlib.Path(scratch), shot, mode), todo)
                )
    finally:
        override.unlink(missing_ok=True)
    failed = {shot[0]: why for shot, why in zip(todo, reasons) if why}
    for name, why in failed.items():
        print(f"trailer: {name} failed, {why}", file=sys.stderr)
    if failed:
        sys.exit(1)
    cut(mode)


if __name__ == "__main__":
    main()
