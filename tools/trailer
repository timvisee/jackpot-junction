def placed(shots: list[tuple]) -> list[tuple]:
    """[shots] each told where in the trailer it starts, `--at=`; a shot of play the match's clock
    there, run on from [constant CLOCK_FROM], or none left for the screens after the whistle; and
    those from the payout slip to the end card the title's chips and cards scrolling over them."""
    out = []
    start = next(t for t, shot in zip(_starts(shots), shots) if shot[0] == "vault")
    names = [shot[0] for shot in shots]
    drifting = (names.index(DRIFT_FROM), names.index(DRIFT_TO))
    for index, (shot, begins) in enumerate(zip(shots, _starts(shots))):
        name, seconds, scene, args, into = shot
        extra = f" --at={begins:g}"
        if scene == PLAY:
            ended = name in ("slip", "podium")
            extra += f" --clock={0.0 if ended else CLOCK_FROM - (begins - start):g}"
        if drifting[0] <= index <= drifting[1]:
            extra += " --drift=1"
        out.append((name, seconds, scene, args + extra, into))
    return out


def _starts(shots: list[tuple]) -> list[float]:
    starts = []
    at = 0.0
    for shot in shots:
        starts.append(at)
        at += shot[1]
    return starts


