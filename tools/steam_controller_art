#!/usr/bin/env bash
# Valve's reference drawing of the Steam Controller of 2026, for the gamepad's blueprint, GAME.md
# 8.3b: its front and its top, out of the engineering drawing in Valve's SteamController repository,
# CC BY-NC-SA 4.0, used with Valve's permission. Into addons/godotsteam/steamcontroller, beside
# GodotSteam, so they are in the Steam builds alone and never in the repository or the GitHub builds,
# with the import settings they are drawn at. pdftocairo, of poppler-utils, writes each sheet as an
# SVG and tools/steam_controller_svg.py takes the two views off them, the drawing's notes left
# behind. tools/steam_addon runs this after GodotSteam; running it again starts over.
set -euo pipefail
cd "$(dirname "$0")/.."
sha256=e572ebe994d270046149424c32477a78a4f496072004109f454907d4c4f24be6
commit=e10919b4b86249817aaca1160aa136ef5622c533
url="https://gitlab.steamos.cloud/api/v4/projects/SteamHardware%2FSteamController/repository/files/steam_controller_reference_20260429.pdf/raw?ref=$commit"

if ! command -v pdftocairo >/dev/null; then
	echo "The Steam Controller's drawings need pdftocairo, of poppler-utils" >&2
	exit 1
fi
work="$(mktemp -d)"
trap 'rm -rf -- "$work"' EXIT
echo "Fetching Valve's Steam Controller drawing"
curl -sSLf --retry 3 -o "$work/drawing.pdf" "$url"
if ! echo "$sha256  $work/drawing.pdf" | sha256sum -c --quiet -; then
	echo "Valve's Steam Controller drawing is not the file it was when it was pinned: $url" >&2
	exit 1
fi
for sheet in 1 2; do
	pdftocairo -svg -f "$sheet" -l "$sheet" "$work/drawing.pdf" "$work/sheet$sheet.svg"
done
rm -rf addons/godotsteam/steamcontroller
mkdir -p addons/godotsteam/steamcontroller
python3 -I tools/steam_controller_svg.py "$work/sheet1.svg" "$work/sheet2.svg" \
	addons/godotsteam/steamcontroller
for view in front top; do
	# Drawn at twice its points, and smaller again on a smaller screen.
	cat >"addons/godotsteam/steamcontroller/$view.svg.import" <<'IMPORT'
[remap]

importer="texture"
type="CompressedTexture2D"

[params]

compress/mode=0
mipmaps/generate=true
svg/scale=2.0
IMPORT
done
echo "The Steam Controller's drawings are in addons/godotsteam/steamcontroller"
