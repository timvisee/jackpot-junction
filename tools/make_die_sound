#!/usr/bin/env python3
"""Builds the die's throw, GAME.md 4.4a and 9.6, into assets/audio/sfx/die_throw_1.ogg to _3.ogg.

One die thrown onto a wooden table, timed to the die drawn on the screen (NameDie): it is picked up
off what it lay on with a faint scuff, flies, and lands three times, each landing lower and sooner
than the one before, as the die is drawn hopping, then settles onto its face with a short rattle.
Each landing is a dull plastic tock on wood rather than a ring: a short burst of noise where its
corner meets the table and its face a moment after, colored by the table it strikes, a low knock
and a woody middle each gone in a few milliseconds, and the die's own click over it, short and not
high; little above eight kilohertz, and nothing ringing on up there as a die on glass would. A little of a room round
it, so it sounds struck in one rather than in nothing. Three takes, each its own die and its own
table, for the game to pick from.

Not part of `make check`: run it again only to change the sounds. Needs ffmpeg, python3 and numpy.

    tools/make_die_sound
"""
import os
import subprocess

import numpy as np

SR = 44100
PEAK = 0.8
SFX = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
                   "assets", "audio", "sfx")

# When the die drawn on the screen comes down, in seconds from the throw: NameDie.TUMBLE, and the
# end of each of its NameDie.HOPS as a share of it. Change them together.
TUMBLE = 0.85
LANDINGS = [0.52, 0.74, 0.88]
# How hard each landing is, and the rattle after the last as it tips onto its face: how long after
# the last landing each tap comes, and how hard.
STRENGTHS = [1.0, 0.55, 0.3]
SETTLE = [(0.032, 0.13), (0.054, 0.08), (0.069, 0.045), (0.079, 0.025)]
LENGTH = 1.15
# Over this the whole throw is rolled off, a die and a table having little up there.
TOP = 8000.0


def lowpass(x, cutoff):
    """A gentle, one-pole roll-off over [cutoff], as its impulse response, for numpy alone."""
    a = 1.0 - np.exp(-2.0 * np.pi * cutoff / SR)
    ir = a * (1.0 - a) ** np.arange(int(5.0 * SR / (2.0 * np.pi * cutoff)) + 1)
    return np.convolve(x, ir)[:len(x)]


def highpass(x, cutoff):
    return x - lowpass(x, cutoff)


def modes(rng, parts, length):
    """A body's ring, as an impulse response: damped modes, [parts] of (low, high, gain, tau), each
    at a frequency of its own between low and high, gone after tau."""
    t = np.arange(int(length * SR)) / SR
    ir = np.zeros(len(t))
    for low, high, gain, tau in parts:
        freq = rng.uniform(low, high)
        ir += gain * np.sin(2 * np.pi * freq * t + rng.uniform(0, 2 * np.pi)) * np.exp(-t / tau)
    return ir


def strike(rng, strength):
    """The die meeting the table: a millisecond or two of noise, what sets both ringing."""
    t = np.arange(int(0.004 * SR)) / SR
    return strength * rng.standard_normal(len(t)) * np.exp(-t / 0.0008)


def put(out, at, sound):
    start = int(at * SR)
    end = min(start + len(sound), len(out))
    out[start:end] += sound[:end - start]


def hit(out, at, strength, die, table, rng, knock=1.0):
    """One meeting of die and table: the strike through the table's body, a low knock and a woody
    middle, harder for a harder landing; and through the die's, a short click, with a little of
    the strike's own edge, its lows and its top taken off."""
    excite = strike(rng, strength)
    wood = np.convolve(excite, table) * knock * strength ** 0.4
    tick = np.convolve(excite, die)
    edge = lowpass(highpass(np.pad(excite, (0, 64)), 1200.0), 7000.0)
    sound = np.zeros(max(len(wood), len(tick), len(edge)))
    sound[:len(wood)] += 0.22 * wood
    sound[:len(tick)] += 0.05 * tick
    sound[:len(edge)] += 0.9 * edge
    put(out, at, sound)


def landing(out, at, strength, die, table, rng):
    """The die coming down: its corner, then its face a few milliseconds later, softer."""
    hit(out, at, strength, die, table, rng)
    hit(out, at + rng.uniform(0.004, 0.009), strength * rng.uniform(0.4, 0.65), die, table, rng)


def scuff(out, rng):
    """Picked up off what it lay on: a faint, soft brush, so the throw is heard at once."""
    t = np.arange(int(0.05 * SR)) / SR
    brush = lowpass(highpass(rng.standard_normal(len(t)), 600.0), 3000.0)
    put(out, 0.0, 0.05 * brush * np.sin(np.pi * t / t[-1]) ** 2)


def room(out, rng):
    """A little of a room: two early reflections and a short tail of noise dying away, some
    fourteen decibels under what is struck, its top rolled off as a room's is."""
    t = np.arange(int(0.09 * SR)) / SR
    tail = lowpass(rng.standard_normal(len(t)), 4000.0) * np.exp(-t / 0.018) * 0.012
    for delay, gain in [(0.007, 0.12), (0.013, 0.07)]:
        tail[int(delay * SR)] += gain
    tail[0] = 1.0
    return np.convolve(out, tail)[:len(out)]


def take(seed):
    rng = np.random.default_rng(seed)
    out = np.zeros(int(LENGTH * SR))
    # Its own table, low and woody, each mode gone quickly, a table under felt or a bench rather
    # than a plate; and its own die, a short click in the low thousands, two modes gone in a
    # millisecond, so it clicks rather than pings.
    table = modes(rng, [
        (130.0, 180.0, 0.75, 0.02),
        (480.0, 680.0, 0.8, 0.008),
        (950.0, 1400.0, 0.75, 0.006),
        (1900.0, 2600.0, 0.45, 0.003),
    ], 0.12)
    die = modes(rng, [(2200.0, 3000.0, 1.0, 0.0009), (3600.0, 4600.0, 0.7, 0.0007)], 0.008)
    scuff(out, rng)
    for share, strength in zip(LANDINGS, STRENGTHS):
        landing(out, share * TUMBLE + rng.uniform(-0.004, 0.004), strength, die, table, rng)
    last = LANDINGS[-1] * TUMBLE
    for after, strength in SETTLE:
        # Tipping over onto its face: light taps with less of the table in them.
        hit(out, last + after * rng.uniform(0.85, 1.15), strength, die, table, rng, knock=0.5)
    return lowpass(room(out, rng), TOP)


def write(out, name):
    fade = int(0.04 * SR)
    out[-fade:] *= np.linspace(1.0, 0.0, fade)
    out *= PEAK / np.max(np.abs(out))
    raw = (np.clip(out, -1.0, 1.0) * 32767).astype("<i2").tobytes()
    path = os.path.join(SFX, name)
    subprocess.run(
        ["ffmpeg", "-v", "error", "-y", "-f", "s16le", "-ar", str(SR), "-ac", "1", "-i", "-",
         "-c:a", "libvorbis", "-q:a", "6", path],
        input=raw, check=True,
    )
    print("wrote %s" % path)


def main():
    for i, seed in enumerate([11, 23, 37]):
        write(take(seed), "die_throw_%d.ogg" % (i + 1))


if __name__ == "__main__":
    main()
