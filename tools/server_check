#!/usr/bin/env bash
# Plays a game on a dedicated server, GAME.md 9.3a, through the real scenes and says whether it
# worked: the server itself and three clients of it, each a process of its own on this machine.
# See tools/server_driver.gd for what each client checks; this checks what the server logged.
#
#   maker:   makes a game from Play Online, chooses a Grand Prix of two maps, plays it, goes on
#            from the first podium and takes everybody back to the lobby from the last, hands the
#            host's say to the joiner with Make host, has it back once the joiner has gone, and leaves
#   joiner:  joins it from the list, plays it, is made the host, and leaves
#   watcher: watches it, and is told the game is over once both players have left
#   stranger: says garbage for a hello at the server and at the game, which drop it and say so
#
# Then the story's Final Hand at a second server, STORY.md 8.1, see tools/server_house_driver.gd:
#
#   maker:   makes a game with the Final Hand due, is dealt it with the say, plays it and stamps
#   joiner:  joins, sees it blacked out, plays it as its own candidate and stamps keeping nothing;
#            the room is back in its lobby once both are through
#
# Usage: tools/server_check          (about a minute)
#
# The server has to be small while it holds no game: started without the game's autoloads, it is
# the engine and little more, and one that grew past SVCHECK_IDLE_MB (160, for the editor build this
# runs) has started loading the game again, see scripts/game_tree.gd.
#
# SVCHECK_SERVER=<binary> runs an exported server build, such as a release's, in place of this
# checkout; it offers no match as short as the clients ask for, so SVCHECK_LENGTH=60 goes with it.
# SVCHECK_PORT picks the server's port, the one game it plays on the port after it, and
# SVCHECK_LOGS=<dir> keeps every process's whole log there. The clients take --length=<seconds>
# for the match, which against a release server, offering nothing as short as the five seconds
# they choose by default, has to be 60: tools/server_driver.gd.
set -uo pipefail
# On the settings and profiles every test and check shares, never the player's own, GAME.md 10.2.
export JJ_SETTINGS="${JJ_SETTINGS:-tests.cfg}"
cd "$(dirname "$0")/.."
port="${SVCHECK_PORT:-7990}"
idle_mb="${SVCHECK_IDLE_MB:-160}"
if [[ -n ${SVCHECK_LOGS:-} ]]; then
	logs=$SVCHECK_LOGS
	mkdir -p "$logs"
else
	logs=$(mktemp -d)
	trap 'rm -rf "$logs"' EXIT
fi
failed=0

# SVCHECK_SERVER=<binary> plays against an exported server build rather than this checkout, which is
# the only way to see what a release build does that an editor build does not.
if [[ -n ${SVCHECK_SERVER:-} ]]; then
	server_cmd=("$SVCHECK_SERVER" --)
else
	server_cmd=(tools/godot --headless --path . -- --server)
fi
# A password from the environment, as a container is told it, which its games inherit from it; the
# clients know it, tools/server_driver.gd.
JJ_PASSWORD="open sesame" timeout 600 "${server_cmd[@]}" --port="$port" --games=1 \
	--name="Server check (test)" >"$logs/server.log" 2>&1 &
server=$!
# Up once it says so, or given up on.
for _ in $(seq 1 100); do
	grep -q " on port $port, up to" "$logs/server.log" 2>/dev/null && break
	sleep 0.2
done
# How much the server holds before anybody has asked it for anything.
hall=$(pgrep -P "$server" | head -1)
idle_kb=$(awk '/^VmRSS/{print $2}' "/proc/$hall/status" 2>/dev/null)
if [[ -z $idle_kb ]]; then
	echo "server check: the server never came up" >&2
	failed=1
else
	echo "server: idle at $((idle_kb / 1024)) MB"
	if ((idle_kb > idle_mb * 1024)); then
		echo "server check: the idle server holds $((idle_kb / 1024)) MB, over $idle_mb MB" >&2
		failed=1
	fi
fi

run() {
	local role=$1
	timeout 480 tools/godot --headless --path . -s tools/server_check.gd -- --role="$role" \
		--port="$port" ${SVCHECK_LENGTH:+--length=$SVCHECK_LENGTH} >"$logs/$role.log" 2>&1
}

run maker &
maker=$!
sleep 1
run joiner &
joiner=$!
run watcher &
watcher=$!
run stranger &
stranger=$!
wait "$maker"
maker_status=$?
wait "$joiner"
joiner_status=$?
wait "$watcher"
watcher_status=$?
wait "$stranger"
stranger_status=$?

# The game ends itself once everybody has gone, and the server says so.
for _ in $(seq 1 50); do
	grep -q "Game 1 is over" "$logs/server.log" && break
	sleep 0.2
done
kill "$server" 2>/dev/null
wait "$server" 2>/dev/null

report() {
	local role=$1 status=$2
	grep -h '^SVCHECK' "$logs/$role.log" | sed "s/^SVCHECK [a-z]* /$role: /"
	if grep -hE 'SCRIPT ERROR|USER ERROR' "$logs/$role.log" | sed "s/^/$role: /" >&2; then
		echo "server check: $role raised script errors" >&2
		failed=1
	fi
	# Anything left behind as it quit, which is what a sound still playing then does, see Game.quit.
	if grep -hE 'leaked at exit|still in use at exit' "$logs/$role.log" | sed "s/^/$role: /" >&2
	then
		echo "server check: $role left something behind at exit" >&2
		failed=1
	fi
	if [[ $status -ne 0 ]]; then
		echo "server check: $role failed" >&2
		failed=1
	fi
}

report maker "$maker_status"
report joiner "$joiner_status"
report watcher "$watcher_status"
report stranger "$stranger_status"

# The stranger's garbage, dropped at the server's door and at its game's, and said, see NetGuard.
for door in "server" "game 1"; do
	if ! grep -qE "$door: Dropped 127.0.0.1: said [0-9]+ bytes that are not a Jackpot Junction hello" \
		"$logs/server.log"; then
		echo "server check: $door never said it dropped the stranger's garbage" >&2
		failed=1
	fi
done

# The first line of the server's log after line $2 that has $1 in it, or nothing.
logged() {
	grep -nF -- "$1" "$logs/server.log" | cut -d: -f1 | awk -v after="$2" '$1 > after' | head -1
}

# What the server's log has to say, in this order; a group of lines joined by | in any order
# among themselves, since the joiner, the watcher and the maker's choice cross on the wire.
said=(
	"server \"Server check (test)\" on port $port"
	"server: Players need the server's password to come in"
	"server: Maker made game 1, on port $((port + 1))|server: Turned away Joiner, from 127.0.0.1: the password was wrong"
	"game 1: Up on port $((port + 1))"
	"game 1: Maker came in to play"
	"game 1: Maker has the host's say"
	"game 1: The host chose the next match: |game 1: Joiner came in to play|game 1: Watcher came in to watch"
	", map 1 of 2"
	"game 1: Playing: "
	"game 1: Results: 1. "
	", map 2 of 2"
	"game 1: Results: 1. "
	"game 1: In the lobby"
	"game 1: Maker made Joiner the host"
	"game 1: Joiner has the host's say"
	"game 1: Joiner left"
	"game 1: Maker has the host's say"
	"game 1: Maker left"
	"game 1: Everybody left, so the game is over"
	"server: Game 1 is over"
)
line=0
for group in "${said[@]}"; do
	IFS='|' read -ra wants <<<"$group"
	last=$line
	for want in "${wants[@]}"; do
		found=$(logged "$want" "$line")
		if [[ -z $found ]]; then
			echo "server check: the server never logged '$want' after line $line" >&2
			failed=1
			break 2
		fi
		((found > last)) && last=$found
	done
	line=$last
done
if grep -hE 'SCRIPT ERROR|USER ERROR' "$logs/server.log" | sed "s/^/server: /" >&2; then
	echo "server check: the server raised script errors" >&2
	failed=1
fi
# And engine errors, which a release build raises where an editor build does not, anything a
# game's process left behind as it ended, a sound playing then, see Game.quit, and word from a
# client that no copy of the game sends, "sent abnormal state", which the clients here never
# are, see NetConduct.
if grep -hE '^ERROR:|leaked at exit|sent abnormal state' "$logs/server.log" |
	sed "s/^/server: /" >&2; then
	echo "server check: the server raised engine errors" >&2
	failed=1
fi
# The Final Hand at a second server of its own, on the ports after the first one's.
house_port=$((port + 10))
JJ_PASSWORD="open sesame" timeout 600 "${server_cmd[@]}" --port="$house_port" --games=1 \
	--name="Server check house (test)" >"$logs/house_server.log" 2>&1 &
house_server=$!
for _ in $(seq 1 100); do
	grep -q " on port $house_port, up to" "$logs/house_server.log" 2>/dev/null && break
	sleep 0.2
done
house() {
	local role=$1
	timeout 480 tools/godot --headless --path . -s tools/server_check.gd -- --house \
		--role="$role" --port="$house_port" ${SVCHECK_LENGTH:+--length=$SVCHECK_LENGTH} \
		>"$logs/house_$role.log" 2>&1
}
house maker &
house_maker=$!
sleep 1
house joiner
house_joiner_status=$?
wait "$house_maker"
house_maker_status=$?
for _ in $(seq 1 50); do
	grep -q "Game 1 is over" "$logs/house_server.log" && break
	sleep 0.2
done
kill "$house_server" 2>/dev/null
wait "$house_server" 2>/dev/null
report "house_maker" "$house_maker_status"
report "house_joiner" "$house_joiner_status"
for want in "game 1: Onto House Rules" "game 1: In the lobby" "server: Game 1 is over"; do
	if ! grep -qF -- "$want" "$logs/house_server.log"; then
		echo "server check: the Final Hand's server never logged '$want'" >&2
		failed=1
	fi
done
if grep -hE 'SCRIPT ERROR|USER ERROR|^ERROR:|leaked at exit' "$logs/house_server.log" |
	sed "s/^/house server: /" >&2; then
	echo "server check: the Final Hand's server raised errors" >&2
	failed=1
fi

if [[ $failed -eq 0 ]]; then
	echo "server check ok"
fi
exit "$failed"
