#!/usr/bin/env bash
# Plays a whole Grand Prix through the real scenes and says whether each run worked: online, with
# the host and its clients as separate processes talking over a port on this machine, and on one
# screen. See tools/multiplayer_driver.gd for what each step checks.
#
#   online a: the host and a second player at its machine, one client, one bot;
#             every seat keeps one joker at random between the maps, and the client gives
#             no name and keeps the one the host hands it
#   online b: the host, two clients, the second with two players at it, and somebody
#             watching, which fills the arena with no bot; everybody chooses a joker to keep,
#             and the game has a password, which each client is asked for and gives, the
#             first a wrong one before it, and the watcher is let in without
#   local:    two players on one machine, one bot; everybody keeps all their jokers
#   eight:    a room of eight, GAME.md 9.3: the host and three clients with two players at each,
#             on a quick match played as its XL and over at once, beside the local run, see
#             tools/eight_driver.gd
#
# Usage: tools/multiplayer_check          (about a minute and a half)
#
# MPCHECK_PING puts a round trip of that many milliseconds between every end of the online runs,
# as a slow LAN or the internet would, see scenes/net/net_lag.gd: MPCHECK_PING=50.
set -uo pipefail
cd "$(dirname "$0")/.."
port="${MPCHECK_PORT:-7851}"
ping="${MPCHECK_PING:-0}"
# MPCHECK_LOGS keeps the whole of each run's output there, for a failure that needs reading.
if [[ -n ${MPCHECK_LOGS:-} ]]; then
	logs=$MPCHECK_LOGS
	mkdir -p "$logs"
else
	logs=$(mktemp -d)
	trap 'rm -rf "$logs"' EXIT
fi
failed=0

# One process: a log name, then the driver's own arguments.
run() {
	local name=$1
	shift
	timeout 240 tools/godot --headless --path . -s tools/multiplayer_check.gd -- "$@" \
		>"$logs/$name.log" 2>&1
}

# A run's output, and a failure for a run that failed or raised a script error anywhere, even
# one that reached its end: the game carried on past something that went wrong.
report() {
	local name=$1 status=$2
	grep -h '^MPCHECK' "$logs/$name.log" | sed "s/^MPCHECK [a-z]* /$name: /"
	if grep -hE 'SCRIPT ERROR|USER ERROR' "$logs/$name.log" | sed "s/^/$name: /" >&2; then
		echo "multiplayer check: $name raised script errors" >&2
		failed=1
	fi
	# Anything left behind as it quit, which is what a sound still playing then does, see Game.quit.
	if grep -hE 'leaked at exit|still in use at exit' "$logs/$name.log" | sed "s/^/$name: /" >&2
	then
		echo "multiplayer check: $name left something behind at exit" >&2
		failed=1
	fi
	if [[ $status -ne 0 ]]; then
		echo "multiplayer check: $name failed" >&2
		failed=1
	fi
}

# The two ends of the wire must agree on how the run stood after every map.
agree() {
	local host=$1 client=$2
	for round in 1 2; do
		a=$(grep -h "^MPCHECK host SCORES $round " "$logs/$host.log" | cut -d' ' -f5- |
			sed 's/ ([0-9.]* s)$//')
		b=$(grep -h "^MPCHECK client SCORES $round " "$logs/$client.log" | cut -d' ' -f5- |
			sed 's/ ([0-9.]* s)$//')
		if [[ -z $a || $a != "$b" ]]; then
			echo "multiplayer check: $host and $client disagree after map $round: '$a' against '$b'" >&2
			failed=1
		fi
	done
}

run host_a --role=host --port="$port" --ping="$ping" --locals=2 --clients=1 --jokers=random --style=1,1,1,1 &
host_a=$!
run client_a --role=client --port="$port" --ping="$ping" --nameless --style=2,2,0,1 --host-style=1,1,1,1 &
client_a=$!
wait "$host_a"
host_a_status=$?
wait "$client_a"
client_a_status=$?

run host_b --role=host --port="$((port + 1))" --ping="$ping" --locals=1 --clients=2 --guests=3 --jokers=choose \
	--password=sesame &
host_b=$!
run client_b1 --role=client --port="$((port + 1))" --ping="$ping" --password=sesame \
	--wrong-first &
client_b1=$!
run client_b2 --role=client --port="$((port + 1))" --ping="$ping" --password=sesame --seats=2 &
client_b2=$!
run watcher_b --role=watcher --port="$((port + 1))" --ping="$ping" &
watcher_b=$!
wait "$host_b"
host_b_status=$?
wait "$client_b1"
client_b1_status=$?
wait "$client_b2"
client_b2_status=$?
wait "$watcher_b"
watcher_b_status=$?

run host_8 --eight --role=host --port="$((port + 2))" --ping="$ping" &
host_8=$!
run client_81 --eight --role=client --port="$((port + 2))" --ping="$ping" &
client_81=$!
run client_82 --eight --role=client --port="$((port + 2))" --ping="$ping" &
client_82=$!
run client_83 --eight --role=client --port="$((port + 2))" --ping="$ping" &
client_83=$!

run local --role=local --jokers=all
local_status=$?
wait "$host_8"
host_8_status=$?
wait "$client_81"
client_81_status=$?
wait "$client_82"
client_82_status=$?
wait "$client_83"
client_83_status=$?

report host_a "$host_a_status"
report client_a "$client_a_status"
report host_b "$host_b_status"
report client_b1 "$client_b1_status"
report client_b2 "$client_b2_status"
report watcher_b "$watcher_b_status"
report local "$local_status"
report host_8 "$host_8_status"
report client_81 "$client_81_status"
report client_82 "$client_82_status"
report client_83 "$client_83_status"
agree host_a client_a
agree host_b client_b1
agree host_b client_b2
if [[ $failed -eq 0 ]]; then
	echo "multiplayer check ok"
fi
exit "$failed"
