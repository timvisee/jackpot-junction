#!/usr/bin/env python3
"""Runs whole matches of bots and reports what they achieved, so "are the bots any good" is a
number rather than an impression. Several seeds, because one match of four bots is mostly luck,
each match its own process and several at once, at a fixed 60 frames a second of the game's
clock: as fast as the machine goes, and with one physics tick to every frame, so the same seed
plays the same match again until the bots themselves drive differently.

Usage: tools/bot_arena                       every level, eight seeds each (a few minutes)
       BOT_LEVELS=hard tools/bot_arena        one level, or several: "easy hard"
       BOT_SEEDS=4242,77,1315 tools/bot_arena the seeds, or BOT_SEEDS=48 for the first 48, and
                                              BOT_SEEDS_FROM=48 for the 48 after those
       BOT_MAP=house_rules tools/bot_arena    on another map than the default one
       BOT_MIRROR=0.5,0.5,0.5 tools/bot_arena bots reading a room of players who use items, burn
                                              nitro and drift, GAME.md 9.1, rather than nobody
       BOT_VS=<git ref> tools/bot_arena       head to head: two seats of each match drive the
                                              brain of that commit, the other two this one's,
                                              swapping seats from one seed to the next
       BOT_COST=1 tools/bot_arena             also times every brain's tick, in microseconds
       JOBS=n                                 processes at once, the cores up to twelve unless
"""

import collections
import concurrent.futures
import os
import pathlib
import re
import shutil
import subprocess
import sys
import tempfile

ROOT = pathlib.Path(__file__).resolve().parent.parent
GODOT = os.environ.get("GODOT", str(ROOT / "tools" / "godot"))
SEEDS = [4242, 77, 1315, 9001, 31337, 2718, 1618, 5150, 8086, 6502, 1984, 4004]
# The scripts of the bots folder that stay this commit's in a head to head: what a brain is given
# and what it writes into, rather than how it decides.
SHARED = {
    "bot_input.gd",
    "bot_difficulty.gd",
    "bot_trait.gd",
    "bot_trait_table.gd",
    "fixed_traits.gd",
    "bot_mirror.gd",
    "bot_emotes.gd",
}
CLASS = re.compile(r"^class_name\s+(\w+)\s*$", re.M)


# What the other brain's own navigator is reached by, built on the match's grid the first time it
# is asked for and kept up with the crates the way the match keeps its own, see match.gd: the
# navigator is part of how a bot drives, so the other brain drives by its own.
OLD_NAV = """

var _old_nav_built: OldArenaNav


func _old_nav() -> OldArenaNav:
	if _old_nav_built == null:
		var nav := OldArenaNav.new(match_node.arena.grid)
		_old_nav_built = nav
		for i: int in match_node.arena.crates.size():
			var cell := match_node.arena.grid.crates[i]
			match_node.arena.crates[i].destroyed.connect(
				func(_by: int) -> void: nav.set_cell_blocked(cell, false)
			)
			match_node.arena.crates[i].respawned.connect(
				func() -> void: nav.set_cell_blocked(cell, true)
			)
	return _old_nav_built
"""


def old_brain(ref: str, into: pathlib.Path) -> None:
    """The bots folder of `ref`, its brain's own scripts renamed Old* and tied together by path,
    since a script outside the project registers no class name of its own, and its navigator."""
    listed = subprocess.run(
        ["git", "ls-tree", "--name-only", ref, "scenes/bots/"],
        cwd=ROOT, capture_output=True, text=True, check=True,
    ).stdout.split()
    listed.append("scripts/arena_nav.gd")
    sources = {}
    for path in listed:
        name = pathlib.Path(path).name
        if not name.endswith(".gd") or name in SHARED:
            continue
        sources[name] = subprocess.run(
            ["git", "show", f"{ref}:{path}"], cwd=ROOT, capture_output=True, text=True, check=True
        ).stdout
    for name in sources:
        sources[name] = sources[name].replace("brain.match_node.nav", "brain._old_nav()")
    sources["bot_brain.gd"] = sources["bot_brain.gd"].replace("match_node.nav", "_old_nav()")
    sources["bot_brain.gd"] += OLD_NAV.replace("OldArenaNav", "ArenaNav")
    classes = {}
    for name, text in sources.items():
        found = CLASS.search(text)
        if found:
            classes[found.group(1)] = name
    for name, text in sources.items():
        text = CLASS.sub("", text)
        own = next((c for c, n in classes.items() if n == name), None)
        used = []
        for cls in classes:
            if re.search(rf"\b{cls}\b", text):
                text = re.sub(rf"\b{cls}\b", "Old" + cls, text)
                if cls != own:
                    used.append(cls)
        consts = "".join(
            f'const Old{cls} := preload("{into / classes[cls]}")\n' for cls in sorted(used)
        )
        # After the extends line, which has to come before anything else in the script: put in
        # front of it, the script does not compile, and the seat keeps the brain it had.
        found = re.search(r"^extends .*$", text, re.M)
        cut = found.end() + 1 if found else 0
        (into / name).write_text(text[:cut] + consts + text[cut:])


def run_match(level: str, seed: int, env: dict, report: pathlib.Path) -> list:
    report.mkdir(parents=True, exist_ok=True)
    command = [
        GODOT, "--headless", "--fixed-fps", "60", "--path", str(ROOT),
        "-s", "addons/gdUnit4/bin/GdUnitCmdTool.gd", "-a", "res://tools/bot_arena.gd",
        "-c", "--ignoreHeadlessMode", "-rd", str(report.relative_to(ROOT)), "-rc", "1",
    ]
    env = dict(env, BOT_LEVEL=level, BOT_SEED=str(seed))
    done = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, errors="replace",
                          env=env)
    if "ARENA-NO-BRAIN" in done.stdout:
        print(f"{level} {seed}: the other brain did not load\n" + done.stdout[-3000:])
        return []
    rows = []
    for line in done.stdout.splitlines():
        if not line.startswith("ARENA "):
            continue
        parts = line.split()
        row = {"level": parts[1], "seed": int(parts[2])}
        for part in parts[3:]:
            key, value = part.split("=", 1)
            try:
                row[key] = float(value)
            except ValueError:
                row[key] = value
        rows.append(row)
    if not rows:
        print(f"{level} {seed}: no match ran\n" + done.stdout[-3000:] + done.stderr[-3000:])
    return rows


def mean(rows: list, key: str) -> float:
    return sum(r.get(key, 0.0) for r in rows) / max(len(rows), 1)


def per_match(rows: list, key: str) -> float:
    """What a match's four seats came to between them, on average over the matches."""
    matches = {(r["level"], r["seed"]) for r in rows}
    return sum(r.get(key, 0.0) for r in rows) / max(len(matches), 1)


def summary(title: str, rows: list) -> None:
    m = lambda k: mean(rows, k)
    shots = sum(r.get("bullets", 0.0) for r in rows)
    hits = sum(r.get("hits", 0.0) for r in rows)
    print(f"== {title}: {len(rows)} bots over {len({r['seed'] for r in rows})} seeds ==")
    print("score: banked %6.0f  end pot %4.0f  cash-outs %4.1f (%4.0f a time)  coins %4.0f"
          "  jackpot %3.0f  pads %4.1f  flushes %.2f  pulls %.2f  bounties %.2f"
          % (m("banked"), m("end_pot"), m("banks"), m("banked") / max(m("banks"), 0.01),
             m("coins"), m("jackpot_chips"), m("pads_taken"), m("flushes"), m("pulls"),
             m("bounties")))
    print("bank:  in passing %4.1f (%4.0f points, %4.1f with a mult)  pot at the end %4.0f"
          % (m("passing_banks"), m("passing_banked"), m("passing_mult"), m("end_pot")))
    print("fight: kills %4.2f  deaths %4.2f (holes %4.2f, own %4.2f)  wounds %4.2f  hit %4.1f"
          "  pot at death %4.0f (lost %4.0f)  peak mult %4.1f  grazes %4.1f  rams %4.1f"
          % (m("kills"), m("deaths"), m("pit_deaths"), m("self_kills"), m("wounds"),
             m("shot_at_me"), m("died_with"), m("death_lost"), m("max_mult"), m("grazes"),
             m("rams")))
    print("aim:   shots %5.1f  hits %4.1f  accuracy %4.1f%%  crates %4.1f  targets %4.1f"
          % (m("bullets"), m("hits"), 100.0 * hits / max(shots, 1.0), m("crates"), m("targets")))
    print("kit:   items %4.1f  jokers %4.1f  nitro %4.1f s  turbo pads %4.1f  drifts %4.1f"
          " (%3.0f m sideways, %4.1f boosts)"
          % (m("items"), m("jokers"), m("nitro"), m("turbo_pads"), m("drifts"), m("drifted"),
             m("boosts_paid")))
    print("drive: %4.0f m  %.2f m/s  wall %2.0f%%  full lock %2.0f%%  stuck %4.1f s  stalled %4.1f s"
          "  gave up %.2f  put down %.2f  nearest kart %4.1f m"
          % (m("driven"), m("speed"), 100 * m("walled"), 100 * m("full_lock"), m("stuck_s"),
             m("stalled_s"), m("gave_up"), m("put_down"), m("neighbor")))
    goals = sorted(((k[2:], m(k)) for k in rows[0] if k.startswith("g_")), key=lambda g: -g[1])
    print("goals: " + "  ".join(f"{name} {100 * share:.0f}%" for name, share in goals))
    if "cost_us" in rows[0]:
        print("cost:  %.1f us a bot a tick" % m("cost_us"))


def main() -> int:
    levels = os.environ.get("BOT_LEVELS", "easy normal hard").split()
    said = os.environ.get("BOT_SEEDS", "8")
    # Past the named ones, as many more as asked for.
    more = SEEDS + [7919 * i + 101 for i in range(1, 200)]
    skip = int(os.environ.get("BOT_SEEDS_FROM", "0"))
    seeds = more[skip : skip + int(said)] if "," not in said else [int(s) for s in said.split(",")]
    jobs = int(os.environ.get("JOBS", "0")) or min(os.cpu_count() or 4, 12)
    env = dict(os.environ, JJ_SETTINGS="tests.cfg")
    scratch = pathlib.Path(tempfile.mkdtemp(prefix="jackpot-junction-arena-"))
    env["XDG_DATA_HOME"] = str(scratch / "data")
    ref = os.environ.get("BOT_VS", "")
    try:
        if ref:
            old = scratch / "old"
            old.mkdir()
            old_brain(ref, old)
            env["BOT_OLD_DIR"] = str(old)
        reports = ROOT / "reports" / "arena"
        work = []
        for level in levels:
            for index, seed in enumerate(seeds):
                seats = "1,3" if index % 2 == 0 else "0,2"
                work.append((level, seed, dict(env, BOT_OLD_SEATS=seats) if ref else env))
        rows = []
        with concurrent.futures.ThreadPoolExecutor(max_workers=jobs) as pool:
            futures = [
                pool.submit(run_match, level, seed, e, reports / f"{level}_{seed}")
                for level, seed, e in work
            ]
            for future in futures:
                rows += future.result()
        if not rows:
            print("no matches ran")
            return 1
        out = ROOT / "reports" / "arena.tsv"
        keys = sorted({k for r in rows for k in r})
        with open(out, "w") as f:
            f.write("\t".join(keys) + "\n")
            for r in rows:
                f.write("\t".join(str(r.get(k, "")) for k in keys) + "\n")
        for level in levels:
            mine = [r for r in rows if r["level"] == level]
            if not mine:
                continue
            if not ref:
                summary(level, mine)
                continue
            new = [r for r in mine if r.get("old", 0.0) == 0.0]
            was = [r for r in mine if r.get("old", 0.0) == 1.0]
            summary(f"{level}, this brain", new)
            summary(f"{level}, {ref}'s brain", was)
            wins = collections.Counter()
            for seed in seeds:
                match = [r for r in mine if r["seed"] == seed]
                if match:
                    best = max(match, key=lambda r: r["banked"])
                    wins["old" if best.get("old", 0.0) == 1.0 else "new"] += 1
            print(f"-- {level}: matches won by this brain {wins['new']}, by {ref}'s {wins['old']}")
        print(f"(every seat in {out.relative_to(ROOT)})")
        return 0
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main())
