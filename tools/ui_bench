#!/usr/bin/env bash
# What the UI of each screen costs a frame, GAME.md 10.7, and whether each is within its budget:
# tools/ui_bench.gd puts up the HUD over a match, the pause menu and the match settings over it,
# the title, the settings and the driving school, each in a user directory of its own, so the
# player's settings and profiles are never touched, at 1920 by 1080 and uncapped, and says its draw
# calls.
#
# Usage: tools/ui_bench [--view=<hud|pause|match|title|settings|school>] [--budget=<draw calls>]
#        (needs a display, or GODOT_HIDDEN=1; about a minute)
set -uo pipefail
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
views=(hud pause match title settings school)
extra=()
for arg in "$@"; do
	case $arg in
	--view=*) views=("${arg#--view=}") ;;
	--) ;;
	*) extra+=("$arg") ;;
	esac
done
failed=0
for view in "${views[@]}"; do
	mkdir -p "$scratch/$view"
	# Godot keeps user:// under XDG_DATA_HOME on Linux, so this points it at a scratch directory.
	XDG_DATA_HOME="$scratch/$view" tools/godot --path . --resolution 1920x1080 --disable-vsync \
		-s tools/ui_bench.gd -- --view="$view" --clean=1 --bots=3 --map=vault --no-countdown \
		--intro=0 --story-invitation=0 "${extra[@]}" || failed=1
done
exit $failed
