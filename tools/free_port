#!/usr/bin/env python3
"""Prints the first port of a block of free UDP ports on this machine, which every session, server
and beacon of the game speaks on, for a check's processes to agree on: dealt at random between 20000
and 60000, so two checks at once from two checkouts or two sessions never host on each other's
ports, and looked at port by port.

Usage: tools/free_port [count]   (8 unless given)
"""

import random
import socket
import sys

LOWEST = 20000
HIGHEST = 60000
TRIES = 100


def free(base: int, count: int) -> bool:
    held = []
    try:
        for port in range(base, base + count):
            probe = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
            held.append(probe)
            probe.bind(("0.0.0.0", port))
        return True
    except OSError:
        return False
    finally:
        for probe in held:
            probe.close()


def main() -> int:
    count = int(sys.argv[1]) if len(sys.argv) > 1 else 8
    for _ in range(TRIES):
        base = random.randrange(LOWEST, HIGHEST - count)
        if free(base, count):
            print(base)
            return 0
    print(f"free_port: no free block of {count} ports", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main())
