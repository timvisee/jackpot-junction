#!/usr/bin/env bash
# What the achievements dialog costs a frame, GAME.md 10.7, and whether that is within its budget:
# tools/achievements_bench.gd opens it in a user directory of its own, so the player's settings and
# profiles are never touched, at 1920 by 1080 and uncapped, and says its draw calls and frame times.
#
# Usage: tools/achievements_bench [-- --budget=<draw calls>]     (needs a display; ten seconds)
set -uo pipefail
cd "$(dirname "$0")/.."
scratch=$(mktemp -d)
trap 'rm -rf "$scratch"' EXIT
# Godot keeps user:// under XDG_DATA_HOME on Linux, so this points it at the scratch directory.
export XDG_DATA_HOME="$scratch"
tools/godot --path . --resolution 1920x1080 --disable-vsync -s tools/achievements_bench.gd "$@"
