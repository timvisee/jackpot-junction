# Godot 4+ specific ignores
.godot/
/android/

# gdUnit4 reports
/reports/

# Export builds
/build/

# Release notes cut from the changelog by the release workflow
/release-notes.md

# Worktrees made for parallel work. Godot skips every folder whose name starts with a dot, so none
# of their scripts is imported into this project, and the export presets leave .claude out.
/.claude/worktrees/

# GodotSteam, fetched by `make steam-addon` for the Steam builds, and the Steam app id written into
# them by `make steam-export`, GAME.md 10.8. Neither is in the repository.
/addons/godotsteam/
/data/steam/app.cfg
# Written by tools/trailer while it records, so its movie writer draws at the size asked for.
/override.cfg
# Python's bytecode, left by the tools' Python scripts when one is imported.
__pycache__/

# The licensed music, GAME.md 10.6: Ovani Sound's terms rule out a public repository, so it lives in
# the private timvisee/jackpot-junction-private, and `make private-assets` links each track in, or
# copies it with tools/private_assets --copy. Everything in the folder is left out but what is
# named below with a `!`, so a track comes into this repository only on purpose, once its license
# allows it. No trailing slash: git takes a symlink for a file, and `music/*/` would miss the links.
/assets/audio/music/*
