# Godot 4+ specific ignores
.godot/
/android/

# gdUnit4 reports
/reports/

# Export builds
/build/

# Release notes cut from the changelog by the release workflow
/release-notes.md

# Worktrees made for parallel work. Godot skips every folder whose name starts with a dot, so none
# of their scripts is imported into this project, and the export presets leave .claude out.
/.claude/worktrees/
