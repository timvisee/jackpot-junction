# Godot 4+ specific ignores
.godot/
/android/

# gdUnit4 reports
/reports/

# Export builds
/build/

# Release notes cut from the changelog by the release workflow
/release-notes.md

# Worktrees made for parallel work. Godot skips every folder whose name starts with a dot, and
# .claude/.gdignore says so again, so none of their scripts is imported into this project.
/.claude/worktrees/
