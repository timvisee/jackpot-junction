; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Jackpot Junction"
config/description="Arena kart game: collect chips, build a multiplier, cash out at the Junction before someone shoots you."
config/version="0.15.3"
config/tags=PackedStringArray("game")
run/main_scene="res://scenes/boot/boot.tscn"
run/main_loop_type="GameTree"
config/quit_on_go_back=false
config/features=PackedStringArray("4.7", "Forward Plus")
run/flush_stdout_on_print=true
boot_splash/bg_color=Color(0.07450981, 0.07058824, 0.09411765, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://qdtnv4nong5v"
config/icon="res://assets/app/icon.png"
config/windows_native_icon="res://assets/app/icon.ico"
config/macos_native_icon="res://assets/app/icon.icns"

[audio]

buses/default_bus_layout="res://data/audio/default_bus_layout.tres"

[autoload]

Game="*res://scripts/autoload/game.gd"
Events="*res://scripts/autoload/events.gd"
Audio="*res://scripts/autoload/audio.gd"
Net="*res://scripts/autoload/net.gd"

[debug]

gdscript/warnings/shadowed_variable=0
gdscript/warnings/shadowed_variable_base_class=0
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom_font="res://assets/fonts/Barlow-Medium.ttf"

[input_devices]

sensors/enable_gravity=true

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="kart"
3d_physics/layer_3="bullet"
3d_physics/layer_4="pickup"
3d_physics/layer_5="trigger"
3d_physics/layer_6="graze"
3d_physics/layer_7="turret"
3d_physics/layer_8="protected"
3d_physics/layer_9="bomb"
3d_physics/layer_10="puppet"
3d_physics/layer_11="ball"

[physics]

3d/physics_engine="Jolt Physics"
common/physics_interpolation=true

[rendering]

rendering_device/driver.windows="d3d12"
textures/vram_compression/import_etc2_astc=true
camera/depth_of_field/depth_of_field_bokeh_shape=0
camera/depth_of_field/depth_of_field_bokeh_quality=0
environment/ssao/quality=0
environment/ssao/adaptive_target=0.3
environment/ssao/blur_passes=1
anti_aliasing/quality/msaa_3d=1
environment/glow/upscale_mode=0
