msgstr "靶场"

#. bet
#: data/loyalty/map.tres
msgid "Land {count} of 30 shots or more in one map"
msgstr "单张地图射击 30 次以上，命中率达 {count}"

#. endorsement
#: data/loyalty/map.tres
msgid "MARKSMAN"
msgstr "神射手"

