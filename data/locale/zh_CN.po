msgstr "涡轮车道"

#. title
#: data/loyalty/map.tres
msgid "The Nitro Pumps"
msgstr "氮气加注站"

#. title
#: data/loyalty/map.tres
msgid "The Records Office"
msgstr "档案科"

#. bet
#: data/loyalty/map.tres
msgid "A map of {count} or more without dying"
msgstr "打完一张地图不阵亡，时长至少 {count}"

#. endorsement
#: data/loyalty/map.tres
msgid "CLEAN RECORD"
msgstr "零事故"

