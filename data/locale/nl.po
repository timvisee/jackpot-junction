msgstr "Stempel de beoordeling van het Huis"

#. title
#: data/achievements/list.tres
msgid "Not This Time"
msgstr "Niet deze keer"

#. objective
#: data/achievements/list.tres
msgid "Tear the House's evaluation off"
msgstr "Scheur de beoordeling van het Huis af"

#. title
#: data/achievements/list.tres
msgid "Employee of the Month"
msgstr "Medewerker van de maand"

#. objective
#: data/achievements/list.tres
msgid "Play a map after the ending"
msgstr "Speel een map na het einde"

#. title
#: data/achievements/list.tres
msgid "Under the Floorboards"
msgstr "Onder de vloerplanken"

#. objective
#: data/achievements/list.tres
msgid "Take all five of Kit's cards"
msgstr "Neem alle vijf kaarten van Kit"

#. title
#: data/achievements/list.tres
msgid "A Fresh Start"
msgstr "Een schone lei"

#. objective
#: data/achievements/list.tres
msgid "Find every note of the story"
msgstr "Vind alle briefjes van het verhaal"

#. title
#: data/achievements/list.tres
msgid "Buzzer Beater"
msgstr "Op de valreep"

#. objective
#: data/achievements/list.tres
msgid "Take the lead with a cash-out in a map's last 5 seconds, and win it"
msgstr "Neem de leiding met een verzilvering in de laatste 5 seconden van een map, en win hem"

#. title
#: data/achievements/list.tres
msgid "Winner Takes All"
msgstr "Winnaar pakt alles"

#. objective
#: data/achievements/list.tres
msgid "Win a Grand Prix in its showdown"
msgstr "Win een Grand Prix in de showdown"

#. title
#: data/achievements/list.tres
msgid "Partners in Crime"
msgstr "Handlangers"

#. objective
#: data/achievements/list.tres
msgid "Cash out on the Junction at the same time as a teammate, and win the map as a team against two or more"
msgstr "Verzilver tegelijk met een teamgenoot op de Junction, en win de map als team tegen twee of meer"

#. title
#: data/achievements/list.tres
msgid "Snatch and Grab"
msgstr "Weggekaapt"

#. objective
#: data/achievements/list.tres
msgid "Take out a kart collecting a Jackpot, then empty that pile yourself"
msgstr "Schakel een kart uit die een jackpot leeghaalt en haal die stapel daarna zelf leeg"

#. objective
#: data/achievements/list.tres
msgid "Make three Royal Flushes in one map"
msgstr "Maak drie Royal flushes in één map"

#. title
#: data/achievements/list.tres
msgid "Road Hog"
msgstr "Wegpiraat"

#. objective
#: data/achievements/list.tres
msgid "Take out two karts with one Boost"
msgstr "Schakel twee karts uit met één Boost"

#. title
#: data/achievements/list.tres
msgid "Slick Operator"
msgstr "Gladjanus"

#. objective
#: data/achievements/list.tres
msgid "Spin out three karts on one oil slick"
msgstr "Laat drie karts tollen op één olievlek"

#. title
#: data/achievements/list.tres
msgid "Dead Ringer"
msgstr "Dubbelganger"

#. objective
#: data/achievements/list.tres
msgid "Have your decoy take out a kart"
msgstr "Laat je lokkart een kart uitschakelen"

#. title
#: data/achievements/list.tres
msgid "Long Way Round"
msgstr "Een hele omweg"

#. objective
#: data/achievements/list.tres
msgid "Hold one drift for 15 seconds"
msgstr "Houd één drift 15 seconden vol"

#. title
#: data/achievements/list.tres
msgid "Property Damage"
msgstr "Materiële schade"

#. objective
#: data/achievements/list.tres
msgid "Break 250 crates"
msgstr "Sla 250 kratten stuk"

#. display name
#: data/ai/traits/balanced.tres
msgid "Balanced"
msgstr "Allrounder"

#. display name
#: data/ai/traits/bumper.tres
msgid "Bumper"
msgstr "Botser"

#. display name
#: data/ai/traits/cautious.tres
msgid "Cautious"
msgstr "Voorzichtige"

#. display name
#: data/ai/traits/grazer.tres
msgid "Grazer"
msgstr "Kogeldanser"

#. display name
#: data/ai/traits/greedy.tres
msgid "Greedy"
msgstr "Hebberd"

#. display name
#: data/ai/traits/hunter.tres
msgid "Hunter"
msgstr "Jager"

#. display name
#: data/jokers/aimbot.tres
msgid "Aimbot"
msgstr "Aimbot"

#. description
#: data/jokers/aimbot.tres
msgid "Every shot leaves the barrel aimed up to {deg} toward the nearest enemy."
msgstr "Elk schot verlaat de loop tot {deg} bijgedraaid naar de dichtstbijzijnde vijand."

#. display name
#: data/jokers/backfire.tres
msgid "Backfire"
msgstr "Rugdekking"

#. description
#: data/jokers/backfire.tres
msgid "Hold the brake, or drift, and your cannon points out of the back of the kart."
msgstr "Houd de rem in, of drift, en je kanon wijst uit de achterkant van de kart."

#. display name
#: data/jokers/big_tank.tres
msgid "Big Tank"
msgstr "Groot magazijn"

#. description
#: data/jokers/big_tank.tres
msgid "{bullets} max live bullets."
msgstr "{bullets} kogels tegelijk in de lucht."

#. display name
#: data/jokers/blind_spot.tres
msgid "Blind Spot"
msgstr "Dode hoek"

#. description
#: data/jokers/blind_spot.tres
msgid "Bots aim at where you are, never at where you are going. No standings board while you hold it."
msgstr "Bots mikken op waar je bent, nooit op waar je heen gaat. Geen tussenstand zolang je hem hebt."

#. kit line
#: data/jokers/blind_spot.tres
msgid "If they can't guess you, they can't aim."
msgstr "Wie ze niet kunnen raden, kunnen ze niet raken."

#. kit back
#: data/jokers/blind_spot.tres
msgid "They don't aim at you. They aim at the you they expect. Give them nothing to expect. —K."
msgstr "Ze mikken niet op jou. Ze mikken op de jij die ze verwachten. Geef ze niets te verwachten. —K."

#. display name
#: data/jokers/brake_check.tres
msgid "Brake Check"
msgstr "Noodstop"

#. description
#: data/jokers/brake_check.tres
msgid "A dead stop with chips in the pot: +1 mult, three a life, one every 8 seconds. Top speed 10% down."
msgstr "Stilstand met fiches in de pot: +1 mult, drie per leven, één per 8 seconden. Topsnelheid 10% lager."

#. kit line
#: data/jokers/brake_check.tres
msgid "Brake on a straight now and then. It hates that."
msgstr "Rem af en toe op een recht stuk. Daar kan het niet tegen."

#. kit back
#: data/jokers/brake_check.tres
msgid "The models never brake on a straight. Nobody would, they figured. So I did, every lap, for a week, and they wrote a memo about it. —K."
msgstr "De modellen remmen nooit op een recht stuk. Dat zou niemand doen, dachten ze. Dus deed ik het, elke ronde, een week lang, en ze schreven er een memo over. —K."

#. display name
#: data/jokers/burnout.tres
msgid "Burnout"
msgstr "Burnout"

#. description
#: data/jokers/burnout.tres
msgid "Your jokers count every drift boost as a turbo pad."
msgstr "Je jokers tellen elke driftboost als een turbopad."

#. display name
#: data/jokers/carbon_copy.tres
msgid "Carbon Copy"
msgstr "Doorslag"

#. description
#: data/jokers/carbon_copy.tres
msgid "A joker your death drops is a copy: you keep your own."
msgstr "Een joker die je bij je dood laat vallen is een kopie: je houdt je eigen exemplaar."

#. display name
#: data/jokers/comeback.tres
msgid "Comeback"
msgstr "Comeback"

#. description
#: data/jokers/comeback.tres
msgid "Respawn with mult equal to half your mult at death, rounded up."
msgstr "Kom terug met een mult van de helft van je mult bij je dood, naar boven afgerond."

#. display name
#: data/jokers/copy_cat.tres
msgid "Copy Cat"
msgstr "Na-aper"

#. description
#: data/jokers/copy_cat.tres
msgid "Counts as one more copy of the joker just before it in your hand, even past its most. Only a joker that stacks."
msgstr "Telt als nog een kopie van de joker vlak ervoor in je hand, zelfs boven zijn maximum. Alleen een joker die stapelt."

#. display name
#: data/jokers/curve_ball.tres
msgid "Curve Ball"
msgstr "Effectbal"

#. description
#: data/jokers/curve_ball.tres
msgid "Your bullets curve hard toward enemies, turning up to {turn} a second, further out, and keep curving after a bounce."
msgstr "Je kogels buigen hard af naar vijanden, tot {turn} per seconde, van verder weg, en blijven buigen na een stuit."

#. display name
#: data/jokers/cushion_shot.tres
msgid "Cushion Shot"
msgstr "Bandstoot"

#. description
#: data/jokers/cushion_shot.tres
msgid "+{coins} every time one of your bullets bounces off a wall."
msgstr "+{coins} telkens als een van je kogels van een muur kaatst."

#. display name
#: data/jokers/daredevil.tres
msgid "Daredevil"
msgstr "Waaghals"

#. description
#: data/jokers/daredevil.tres
msgid "A graze while you are wounded patches you up."
msgstr "Een schampschot terwijl je gewond bent, lapt je op."

#. display name
#: data/jokers/deep_pockets.tres
msgid "Deep Pockets"
msgstr "Diepe zakken"

#. description
#: data/jokers/deep_pockets.tres
msgid "{slots} joker slots, and every Deep Pockets stands in one of them."
msgstr "{slots} jokerslots, en elke Diepe zakken neemt er één van in."

#. display name
#: data/jokers/direct_debit.tres
msgid "Direct Debit"
msgstr "Incasso"

#. description
#: data/jokers/direct_debit.tres
msgid "{points} points of your pot bank themselves every second, wherever you are. Your mult is left alone."
msgstr "Elke seconde zetten {points} punten van je pot zichzelf op de bank, waar je ook bent. Je mult blijft ongemoeid."

#. display name
#: data/jokers/double_tap.tres
msgid "Double Tap"
msgstr "Genadeschot"

#. description
#: data/jokers/double_tap.tres
msgid "Your bullets wait out only {share} of a wounded kart's moment of grace."
msgstr "Je kogels wachten maar {share} van de genadetijd van een gewonde kart af."

#. display name
#: data/jokers/echo.tres
msgid "Echo"
msgstr "Echo"

#. description
#: data/jokers/echo.tres
msgid "Your jokers that pay chips or mult pay again one time in four."
msgstr "Je jokers die fiches of mult uitbetalen, betalen één op de vier keer nog eens uit."

#. display name
#: data/jokers/flush_draw.tres
msgid "Flush Draw"
msgstr "Flush draw"

#. description
#: data/jokers/flush_draw.tres
msgid "Two cards of a suit are enough to be Suited."
msgstr "Twee kaarten van één kleur zijn genoeg voor Suited."

#. display name
#: data/jokers/getaway_driver.tres
msgid "Getaway Driver"
msgstr "Vluchtauto"

#. description
#: data/jokers/getaway_driver.tres
msgid "Junction drain ramps {times} as fast."
msgstr "Het leeglopen op de Junction loopt {times} zo snel op."

#. display name
#: data/jokers/glass_jackpot.tres
msgid "Glass Jackpot"
msgstr "Glazen jackpot"

#. description
#: data/jokers/glass_jackpot.tres
msgid "Completed cash-outs pay 150%, but dying drops all your chips and 2 jokers."
msgstr "Voltooide verzilveringen betalen 150%, maar bij je dood laat je al je fiches en 2 jokers vallen."

#. display name
#: data/jokers/green_light.tres
msgid "Green Light"
msgstr "Groen licht"

#. description
#: data/jokers/green_light.tres
msgid "Turbo pads give {mult} mult."
msgstr "Turbopads geven {mult} mult."

#. display name
#: data/jokers/guardian_angel.tres
msgid "Guardian Angel"
msgstr "Beschermengel"

#. description
#: data/jokers/guardian_angel.tres
msgid "A hit about to cost you a life uses your Shield or Bullet Wipe instead."
msgstr "Een treffer die je een leven zou kosten, gebruikt in plaats daarvan je Schild of Kogelwisser."

#. display name
#: data/jokers/hair_trigger.tres
msgid "Hair Trigger"
msgstr "Kort lontje"

#. description
#: data/jokers/hair_trigger.tres
msgid "Fire cooldown {cut}."
msgstr "Herlaadtijd {cut}."

#. display name
#: data/jokers/high_roller.tres
msgid "High Roller"
msgstr "High roller"

#. description
#: data/jokers/high_roller.tres
msgid "All mult gains are doubled, but death banks 0%."
msgstr "Alle multwinst wordt verdubbeld, maar je dood zet 0% op de bank."

#. display name
#: data/jokers/hot_streak.tres
msgid "Hot Streak"
msgstr "Op dreef"

#. description
#: data/jokers/hot_streak.tres
msgid "{mult} mult every 10 seconds you stay on the floor."
msgstr "{mult} mult per 10 seconden dat je overeind blijft."

#. display name
#: data/jokers/insurance_policy.tres
msgid "Insurance Policy"
msgstr "Verzekering"

#. description
#: data/jokers/insurance_policy.tres
msgid "Bank all that is left of your pot on death."
msgstr "Zet bij je dood alles wat er van je pot over is op de bank."

#. display name
#: data/jokers/jerry_can.tres
msgid "Jerry Can"
msgstr "Jerrycan"

#. description
#: data/jokers/jerry_can.tres
msgid "Nitro refills {times} as fast."
msgstr "Nitro vult {times} zo snel bij."

#. display name
#: data/jokers/loaded_dice.tres
msgid "Loaded Dice"
msgstr "Valse stenen"

#. description
#: data/jokers/loaded_dice.tres
msgid "Every chip has a {chance} chance to count as a gold chip."
msgstr "Elke fiche heeft {chance} kans om als gouden fiche te tellen."

#. description
#: data/jokers/loose_change.tres
msgid "The chips you drop never fade back to the House. You drop half again as many."
msgstr "De fiches die je laat vallen, vervagen nooit terug naar het Huis. Je laat er anderhalf keer zoveel vallen."

#. kit line
#: data/jokers/loose_change.tres
msgid "What they don't pick up isn't theirs."
msgstr "Wat zij niet oprapen, is niet van hen."

#. kit back
#: data/jokers/loose_change.tres
msgid "Everything that hits their floor goes back to them, sooner or later. Not this. Let somebody else have it. —K."
msgstr "Alles wat op hun vloer valt, gaat vroeg of laat terug naar hen. Dit niet. Gun het een ander. —K."

#. display name
#: data/jokers/lucky_charm.tres
msgid "Lucky Charm"
msgstr "Geluksbrenger"

#. description
#: data/jokers/lucky_charm.tres
msgid "Slot machines pay you a step better: a pair as three of a kind, three of a kind as three sevens."
msgstr "Gokkasten betalen je een stap beter uit: een paar als drie gelijke, drie gelijke als drie zevens."

#. display name
#: data/jokers/lucky_seven.tres
msgid "Lucky Seven"
msgstr "Gelukszeven"

#. description
#: data/jokers/lucky_seven.tres
msgid "Every 7 chips you collect give {mult} mult, a gold chip counting as five."
msgstr "Elke 7 fiches die je pakt geven {mult} mult, een gouden fiche telt als vijf."

#. display name
#: data/jokers/magnet_hubcaps.tres
msgid "Magnet Hubcaps"
msgstr "Magneetvelgen"

#. description
#: data/jokers/magnet_hubcaps.tres
msgid "Pickup radius times {times}."
msgstr "Oppakbereik maal {times}."

#. display name
#: data/jokers/nitro_habit.tres
msgid "Nitro Habit"
msgstr "Nitroverslaafd"

#. description
#: data/jokers/nitro_habit.tres
msgid "Drift exit boosts and turbo pads last {times} as long."
msgstr "Driftboosts en turbopads duren {times} zo lang."

#. display name
#: data/jokers/not_today.tres
msgid "Not Today"
msgstr "Vandaag niet"

#. description
#: data/jokers/not_today.tres
msgid "Skip a pick: +2 mult when you come back. Take one of theirs: 1 mult off."
msgstr "Sla een keuze over: +2 mult als je terugkomt. Neem een van de hunne: 1 mult eraf."

#. kit line
#: data/jokers/not_today.tres
msgid "Say no to one of theirs."
msgstr "Zeg nee tegen een van de hunne."

#. kit back
#: data/jokers/not_today.tres
msgid "Every card they deal you is a question, and the answer they want is yes. This one is for the other answer. —K."
msgstr "Elke kaart die ze je toedelen is een vraag, en het antwoord dat ze willen is ja. Deze is voor het andere antwoord. —K."

#. display name
#: data/jokers/odometer.tres
msgid "Odometer"
msgstr "Kilometerteller"

#. description
#: data/jokers/odometer.tres
msgid "+{coins} for every 20 m you drive, meters on nitro counting double."
msgstr "+{coins} per 20 m die je rijdt, meters op nitro tellen dubbel."

#. display name
#: data/jokers/pack_rat.tres
msgid "Pack Rat"
msgstr "Hamsteraar"

#. description
#: data/jokers/pack_rat.tres
msgid "{items} items in reserve, brought out as the one in hand is used."
msgstr "{items} items in reserve, die volgen zodra je het item in je hand gebruikt."

#. display name
#: data/jokers/payday.tres
msgid "Payday"
msgstr "Betaaldag"

#. description
#: data/jokers/payday.tres
msgid "+{coins} every second, wherever you are."
msgstr "+{coins} per seconde, waar je ook bent."

#. display name
#: data/jokers/pickpocket.tres
msgid "Pickpocket"
msgstr "Zakkenroller"

#. description
#: data/jokers/pickpocket.tres
msgid "Kills move 50% of the victim's chips into your pot; the victim drops none."
msgstr "Kills verplaatsen 50% van de fiches van het slachtoffer naar je pot; het slachtoffer laat er geen vallen."

#. display name
#: data/jokers/pit_crew.tres
msgid "Pit Crew"
msgstr "Pitcrew"

#. description
#: data/jokers/pit_crew.tres
msgid "Turbo pads refill {share} of your nitro tank, once every 3 s."
msgstr "Turbopads vullen {share} van je nitrotank bij, eens per 3 s."

#. display name
#: data/jokers/road_rage.tres
msgid "Road Rage"
msgstr "Verkeershufter"

#. description
#: data/jokers/road_rage.tres
msgid "Ramming above 90% of top speed kills without Boost, but top speed is -10%."
msgstr "Rammen boven 90% van je topsnelheid doodt zonder Boost, maar je topsnelheid is -10%."

#. display name
#: data/jokers/royal_court.tres
msgid "Royal Court"
msgstr "Koninklijk hof"

#. description
#: data/jokers/royal_court.tres
msgid "Come back with +1 mult for every Cursed joker you hold."
msgstr "Kom terug met +1 mult per vervloekte joker die je hebt."

#. display name
#: data/jokers/rubber_bumpers.tres
msgid "Rubber Bumpers"
msgstr "Rubberbumpers"

#. description
#: data/jokers/rubber_bumpers.tres
msgid "Your bullets bounce off walls {more} more."
msgstr "Je kogels kaatsen {more} vaker van muren."

#. display name
#: data/jokers/scar_tissue.tres
msgid "Scar Tissue"
msgstr "Littekenweefsel"

#. description
#: data/jokers/scar_tissue.tres
msgid "{lives}, but nothing heals you: only coming back does."
msgstr "{lives}, maar niets geneest je: alleen terugkomen wel."

#. display name
#: data/jokers/second_wind.tres
msgid "Second Wind"
msgstr "Tweede adem"

#. description
#: data/jokers/second_wind.tres
msgid "Come back with a full tank of nitro and a Boost running."
msgstr "Kom terug met een volle tank nitro en een Boost die al loopt."

#. display name
#: data/jokers/slipstream.tres
msgid "Slipstream"
msgstr "Slipstream"

#. description
#: data/jokers/slipstream.tres
msgid "Grazes give {mult} mult instead of +0.5."
msgstr "Schampschoten geven {mult} mult in plaats van +0,5."

#. display name
#: data/jokers/snake_eyes.tres
msgid "Snake Eyes"
msgstr "Slangenogen"

#. description
#: data/jokers/snake_eyes.tres
msgid "Start every life with mult 3, but grazes give nothing."
msgstr "Begin elk leven met mult 3, maar schampschoten leveren niets op."

#. display name
#: data/jokers/snowball.tres
msgid "Snowball"
msgstr "Sneeuwbal"

#. description
#: data/jokers/snowball.tres
msgid "Fire rate +10% for every kill this life, up to +50%."
msgstr "Vuursnelheid +10% per kill dit leven, tot +50%."

#. display name
#: data/jokers/spare_tire.tres
msgid "Spare Tire"
msgstr "Reservewiel"

#. description
#: data/jokers/spare_tire.tres
msgid "{lives}. Lost when you die."
msgstr "{lives}. Weg als je doodgaat."

#. display name
#: data/jokers/tailslide.tres
msgid "Tailslide"
msgstr "Slippertje"

#. description
#: data/jokers/tailslide.tres
msgid "+{coins} for every 8 m you drift."
msgstr "+{coins} per 8 m die je drift."

#. display name
#: data/jokers/tight_grip.tres
msgid "Tight Grip"
msgstr "Vaste greep"

#. description
#: data/jokers/tight_grip.tres
msgid "Your pot never spills: no chips dropped on death or knocked out by a ram."
msgstr "Je pot morst nooit: geen fiches die vallen bij je dood of eruit geramd worden."

#. display name
#: data/jokers/toll_booth.tres
msgid "Toll Booth"
msgstr "Tolhuisje"

#. description
#: data/jokers/toll_booth.tres
msgid "Whenever another kart completes a cash-out, you bank {share} of it."
msgstr "Telkens als een andere kart een verzilvering voltooit, zet jij er {share} van op de bank."

#. display name
#: data/jokers/under_the_table.tres
msgid "Under the Table"
msgstr "Onder de toonbank"

#. description
#: data/jokers/under_the_table.tres
msgid "Your bank is off the standings until the whistle: no bounty, no match point. Last Call pays you single."
msgstr "Je bank staat tot het eindsignaal buiten de stand: geen premie, geen matchpoint. De laatste ronde telt voor jou niet dubbel."

#. kit line
#: data/jokers/under_the_table.tres
msgid "Keep it off their board."
msgstr "Houd het van hun bord."

#. kit back
#: data/jokers/under_the_table.tres
msgid "Their board is how they keep count of you. Stay off it for a while and watch what they do. —K."
msgstr "Met hun bord houden ze jou bij. Blijf er een tijdje af en kijk wat ze doen. —K."

#. display name
#: data/jokers/vulture.tres
msgid "Vulture"
msgstr "Aasgier"

#. description
#: data/jokers/vulture.tres
msgid "Chips dropped by other karts are worth {coins} to you."
msgstr "Fiches die andere karts laten vallen, zijn voor jou {coins} waard."

#. display name
#: data/jokers/wild_card.tres
msgid "Wild Card"
msgstr "Wildcard"

#. description
#: data/jokers/wild_card.tres
msgid "Respawn offers {offers} jokers instead of 3."
msgstr "Bij terugkomst krijg je {offers} jokers aangeboden in plaats van 3."

#. title
#: data/loyalty/map.tres
msgid "The Slip Road"
msgstr "De oprit"

#. bet
#: data/loyalty/map.tres
msgid "Activate your loyalty card"
msgstr "Activeer je klantenkaart"

#. title
#: data/loyalty/map.tres
msgid "The Cashier's Cage"
msgstr "Het kassaloket"

#. title
#: data/loyalty/map.tres
msgid "The Card Room"
msgstr "De kaartkamer"

#. title
#: data/loyalty/map.tres
msgid "Chip Alley"
msgstr "Fichesteeg"

#. title
#: data/loyalty/map.tres
msgid "The High Limit Room"
msgstr "De hoge-inzetzaal"

#. bet
#: data/loyalty/map.tres
msgid "Cash out {count} at once"
msgstr "Verzilver {count} in één keer"

#. title
#: data/loyalty/map.tres
msgid "Flush Row"
msgstr "Flushstraat"

#. title
#: data/loyalty/map.tres
msgid "The Ten Times Bar"
msgstr "Café Tienvoud"

#. bet
#: data/loyalty/map.tres
msgid "Cash out at ×{count} mult or more"
msgstr "Verzilver bij ×{count} mult of meer"

#. title
#: data/loyalty/map.tres
msgid "The Prize Counter"
msgstr "De prijzenbalie"

#. title
#: data/loyalty/map.tres
msgid "Jackpot Plaza"
msgstr "Jackpotplein"

#. title
#: data/loyalty/map.tres
msgid "The Bounty Board"
msgstr "Het premiebord"

#. bet
#: data/loyalty/map.tres
msgid "Collect {count} bounties"
msgstr "Incasseer {count} premies"

#. title
#: data/loyalty/map.tres
msgid "The Last Call Bar"
msgstr "Café De Laatste Ronde"

#. bet
#: data/loyalty/map.tres
msgid "Win a map you were not leading as Last Call began"
