[resource]
script = ExtResource("1_map")
grid = "............1...........3...........5...........9
            :                       :           :
            2...........8...........6           0
            :                       :           :
            4.......................7...........%
            :                       :
            :                       +.........+
            :                                 :
            :               @@@               :
            :     +---------@@@---------+     :
            :     |         @@@         |     :
            :     |                     n-----f-----e-----+
            :     |                     |                 |
G-----------F-----O                     m-----l-----------g
|           |     |                           |           |
M-----J-----E-----N                           j           d
|     |                                       |           |
H-----D-----I-----B                     k-----i-----------h
|                 |                     |                 |
L-----C-----K-----A                     a-----b-----c-----+
                  |                     |
                  +----------*----------+
                             |"
